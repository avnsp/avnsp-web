- if admin?
  .page-actions
    %a.btn.btn-primary{href: url('/new')} Skapa nytt album
.container-narrow.text-center
  %h1 Album
  - flash.keys.each do |key|
    %div{class: "alert alert-#{key}", role: :alert}
      = flash[key]
  %dl
    - @albums.each do |a|
      %dt
        %a{href: url("/#{a.id}")}= a.title
      %dd.albums-list-spacing
        Skapat av:
        %a{href: "/member/#{a.created_by}"}= a.member.full_name
