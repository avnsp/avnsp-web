.page-back
  %a.btn{href: url("/#{@photo.album_id}")} &#8592; Gå tillbaka till albumet
.text-center
  %h3= @photo.caption || "Tagen #{@photo.timestamp.to_date}"
.overlay
  %a.float-left{href: url("/#{@photo.album_id}/#{@prev_id}")} &#8592;
  %a.float-right{href: url("/#{@photo.album_id}/#{@next_id}")} &#8594;
  %img.img-fluid{src: @photo.web_url, alt: @photo.caption || @photo.name}
.text-center
  %a{href: @photo.original_temp, target: '_blank', rel: 'noopener'} Visa original
  - if admin?
    %form{method: :post, action: url("/#{@photo.album_id}/#{@photo.id}/delete"), data: {confirm: "Flytta bilden till papperskorgen? Den kan återställas i #{Trash::DAYS} dagar."}}
      != csrf_token_tag
      %button.btn.btn-danger.btn-small{type: :submit} Ta bort bild
%h2.text-center Kommentarer
- @comments.each do |c|
  %div
    %a{href: "/member/#{c.member_id}"}= c.member.full_name
  .grid.grid-2
    %div
      %img.img-thumb{src: c.member.thumb_cdn, alt: "ingen profilbild"}
    %div
      = c.comment
  %div
    %small.text-muted
      %em= c.timestamp.strftime('%Y-%m-%d %H:%M')
  %hr
%form{method: :post, action: url("/#{@photo.id}/comment")}
  != csrf_token_tag
  .form-group
    %input{type: :text, name: :comment, placeholder: "Kommentera här"}
  %button.btn{type: :submit} Spara
%script{src: asset_path("/js/confirm.js")}
