- @members.each do |m|
  %tr
    %td
      %a{href: url(m[:id])}= m.last_name
    %td{data: {label: 'Förnamn'}}= m.first_name
    %td{data: {label: 'Smeknamn'}}= m.nick
    %td{data: {label: 'Program'}}= m.studied
    %td{data: {label: 'Inskrivningsår'}}= m.started
    %td
    %td.col-email{data: {label: 'Email'}}!= email_breakable(m.email)
