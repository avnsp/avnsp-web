!= haml :_party_back, layout: false
%form.print-hide{method: :post}
  != csrf_token_tag
  %fieldset
    %legend Ny anmälan
    .form-group
      %label Medlem
      %select{name: 'member_id'}
        %option{value: ''} Välj medlem...
        - @members.each do |m|
          %option{value: m[:id]} #{m[:first_name]} #{m[:last_name]}
    .checkbox
      %label
        %input{type: :checkbox, name: :vegitarian, value: 'true'}
        Vegetariskt
    .checkbox
      %label
        %input{type: :checkbox, name: :non_alcoholic, value: 'true'}
        Alkoholfritt
    .form-group
      %label Allergier
      %input{type: :text, name: :allergies}
    .form-group
      %label Meddelande till arrangörerna
      %textarea{name: :message}
    %h4 Högerfot
    .form-group
      %label Namn
      %input{type: :text, name: 'right_foot[name]'}
    .checkbox
      %label
        %input{type: :checkbox, name: 'right_foot[vegitarian]', value: 'true'}
        Vegetariskt
    .checkbox
      %label
        %input{type: :checkbox, name: 'right_foot[non_alcoholic]', value: 'true'}
        Alkoholfritt
    .form-group
      %label Allergier
      %input{type: :text, name: 'right_foot[allergies]'}
    %button.btn spara
.print-hide
  %hr
  %h3 Anmälningar

%table.table-stack
  %thead
    %tr
      %th Namn
      %th Allergier
      %th Alkoholfritt
      %th Vegiterian
      %th Meddelande
      %th Högerfot
      %th.print-hide &nbsp;
  %tbody
    - @attendances.each do |a|
      %tr
        %td= "#{a[:first_name]} #{a[:last_name]}"
        %td{data: {label: 'Allergier'}}= a[:allergies]
        %td{data: {label: 'Alkoholfritt'}}= a[:non_alcoholic] ? 'Ja' : 'Nej'
        %td{data: {label: 'Vegetariskt'}}= a[:vegitarian] ? 'Ja' : 'Nej'
        %td{data: {label: 'Meddelande'}}= a[:message]
        %td{data: {label: 'Högerfot'}}= a[:rf_name] && 'Ja'
        %td.print-hide
          %form{method: :post, action: url("/attendance/#{a[:id]}/delete"), data: {confirm: "Ta bort #{a[:first_name]} #{a[:last_name]}? Anmälan och uppgifterna i den (allergier, högerfot m.m.) raderas och går inte att ångra."}}
            != csrf_token_tag
            %button.btn.btn-small.btn-danger -
      - if a[:rf_name]
        %tr.sub-row
          %td{data: {label: 'Högerfot'}}= "#{a[:rf_name]}"
          %td{data: {label: 'Allergier'}}= a[:rf_allergies]
          %td{data: {label: 'Alkoholfritt'}}= a[:rf_non_alcoholic] ? 'Ja' : 'Nej'
          %td{colspan: 4, data: {label: 'Vegetariskt'}}= a[:rf_vegitarian] ? 'Ja' : 'Nej'
%script{src: asset_path("/js/confirm.js")}
