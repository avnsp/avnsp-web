%form{method: :post, action: url('remind')}
  != csrf_token_tag
  .page-header
    %h3 Medlemmar
    .page-header-actions
      - if @members.any? { |m| m[:balance]&.negative? }
        %input.btn{type: :submit, value: 'Skicka Påminnelse'}
      %a.btn{href: url('new')} Ny medlem
  %table.table-stack
    %thead
      %tr
        %th Namn
        %th Email
        %th Sektion
        %th Saldo
    %tbody
      - @members.each do |m|
        %tr{class: m[:balance]&.negative? ? 'danger' : nil}
          %td
            %a{href: url(m[:id])}= [m[:last_name], m[:first_name]].join(', ')
          %td.col-email{data: {label: 'Email'}}!= email_breakable(m[:email])
          %td{data: {label: 'Sektion'}}= m[:studied]
          %td{data: {label: 'Saldo'}}= m[:balance]
